{
  "name": "site-spec-mcp",
  "mcpName": "io.github.ariaxhan/site-spec",
  "version": "0.3.2",
  "description": "MCP server for site-spec: audit any website's invisible foundation (SEO, accessibility, privacy, structured data, AI searchability) and auto-fix what's broken, from inside your agent.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Aria Han",
  "homepage": "https://github.com/ariaxhan/site-spec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariaxhan/site-spec.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/ariaxhan/site-spec/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "site-spec-mcp": "./dist/mcp.mjs"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/mcp.mjs && chmod +x dist/mcp.mjs",
    "typecheck": "tsc -b",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@site-spec/core": "*",
    "esbuild": "^0.25.0",
    "zod": "^3.25.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "seo-audit",
    "accessibility-audit",
    "ai-searchability",
    "llms-txt",
    "website-audit",
    "ai-agents"
  ],
  "files": [
    "dist",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  }
}
